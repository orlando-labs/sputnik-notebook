#!/usr/bin/env bash
set -euo pipefail
release=/ssd1Tb/sputnik-remote-core-releases/20261101-notebook-core
container=sputnik-core-candidate-$(date -u +%Y%m%dT%H%M%S)-$$
state=$release/candidate-state
packages=/ssd1Tb/sputnik-remote-core-releases/20261031-packages-1.0.0/container-packages
mkdir -p "$state"
chmod 700 "$state"
cleanup() { docker rm -fv "$container" >/dev/null 2>&1 || true; }
trap cleanup EXIT
"$release/run-container" --image "$1" --name "$container" --backend cuda \
  --state "$state" --root "$state" --packages "$packages" --cache "$release/candidate-cache" \
  --port 18766 --task-threads 56 --ffi-threads 32 \
  --gpu-devices GPU-08a27f45-3e58-12a9-4626-4997e56e765f,GPU-f8d896e0-2607-a025-88a1-7ed8979035af
for ((i=0;i<90;i++)); do
  if [[ $(docker inspect --format '{{.State.Health.Status}}' "$container") == healthy ]]; then break; fi
  sleep 1
done
[[ $(docker inspect --format '{{.State.Health.Status}}' "$container") == healthy ]]
uuids=$(docker exec "$container" nvidia-smi --query-gpu=uuid --format=csv,noheader | sort)
[[ "$uuids" == $'GPU-08a27f45-3e58-12a9-4626-4997e56e765f\nGPU-f8d896e0-2607-a025-88a1-7ed8979035af' ]]
docker exec "$container" nvidia-smi --query-gpu=name,uuid --format=csv,noheader
docker exec "$container" sh -c 'if command -v python3 || command -v python; then exit 1; fi; sputnik --version'
docker cp "$release/container-check.s" "$container:/tmp/container-check.s"
docker exec -e SPUTNIK_PKG_HOME=/tmp/maintenance-packages "$container" sputnik run /tmp/container-check.s \
  --grant fs.read --grant fs.write --grant fs.metadata --grant net.connect --grant random.secure -- \
  --root "$state" --mode gpu --gpus 2
printf 'PASS candidate: health, short imports, shared installation, RTX 3090/4090, no Python\n'
