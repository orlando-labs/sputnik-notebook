#!/usr/bin/env bash
set -euo pipefail
release=/ssd1Tb/sputnik-remote-core-releases/20261101-notebook-core
root=/home/slowpilot/sputnik-remote-core
state=$root/state
packages=/ssd1Tb/sputnik-remote-core-releases/20261031-packages-1.0.0/container-packages
cache=/ssd1Tb/sputnik-remote-core-releases/20261031-packages-1.0.0/container-cache
image=$1
container=sputnik-remote-core
stamp=$(date -u +%Y%m%dT%H%M%SZ)
backup=$release/backups/before-core-$stamp
previous=sputnik-core-before-$stamp
mkdir -p "$backup"
chmod 700 "$backup"
cp -p "$root/start-current.sh" "$backup/start-current.sh"
docker inspect --format '{{.Image}}' "$container" > "$backup/previous-image.txt"
token_before=$(sha256sum "$state/token" | cut -d' ' -f1)
gateway=$(docker top "$container" -eo pid,args | awk '/--mode gateway/ {print $1}')
[[ "$gateway" =~ ^[0-9]+$ ]] || { printf 'Could not identify one gateway\n' >&2; exit 1; }
rollback=true
stopped=false
renamed=false
backed_up=false
cleanup() {
  result=$?
  if "$rollback"; then
    if "$stopped"; then
      if "$renamed"; then
        docker rm -f "$container" >/dev/null 2>&1 || true
        docker rename "$previous" "$container"
      fi
      if "$backed_up"; then
        mv "$state" "$backup/failed-state"
        cp -a --reflink=auto "$backup/state" "$state"
      fi
      cp -p "$backup/start-current.sh" "$root/start-current.sh"
      docker update --restart unless-stopped "$container" >/dev/null
      docker start "$container" >/dev/null
      printf 'ROLLED BACK to previous container; backup=%s\n' "$backup" >&2
    else
      kill -CONT "$gateway" 2>/dev/null || true
      docker update --restart unless-stopped "$container" >/dev/null
    fi
  fi
  exit "$result"
}
trap cleanup EXIT
check() {
  docker exec -e SPUTNIK_PKG_HOME=/tmp/maintenance-packages "$container" sputnik run /tmp/container-check.s \
    --grant fs.read --grant fs.write --grant fs.metadata --grant net.connect --grant random.secure -- \
    --root "$state" "$@"
}
docker cp "$release/container-check.s" "$container:/tmp/container-check.s"
docker update --restart=no "$container" >/dev/null
# Freeze admission; the independent execution agent remains available to audit.
kill -STOP "$gateway"
check --mode retire --output /tmp/state-before.json
docker cp "$container:/tmp/state-before.json" "$backup/state-before.json"
kill -TERM "$gateway"
kill -CONT "$gateway"
docker stop "$container" >/dev/null
stopped=true
cp -a --reflink=auto "$state" "$backup/state"
backed_up=true
docker rename "$container" "$previous"
renamed=true
args=(--image "$image" --backend cuda --state "$state" --root "$state"
  --packages "$packages" --cache "$cache"
  --gpu-devices GPU-08a27f45-3e58-12a9-4626-4997e56e765f,GPU-f8d896e0-2607-a025-88a1-7ed8979035af
  --task-threads 56 --ffi-threads 32)
"$release/run-container" "${args[@]}"
for ((i=0;i<90;i++)); do
  if [[ $(docker inspect --format '{{.State.Health.Status}}' "$container") == healthy ]]; then break; fi
  sleep 1
done
[[ $(docker inspect --format '{{.State.Health.Status}}' "$container") == healthy ]]
uuids=$(docker exec "$container" nvidia-smi --query-gpu=uuid --format=csv,noheader | sort)
[[ "$uuids" == $'GPU-08a27f45-3e58-12a9-4626-4997e56e765f\nGPU-f8d896e0-2607-a025-88a1-7ed8979035af' ]]
docker exec "$container" nvidia-smi --query-gpu=name,uuid --format=csv,noheader
docker exec "$container" sh -c 'if command -v python3 || command -v python; then exit 1; fi; if dpkg-query -W -f="\${Package}\n" | grep -E "^(python|libpython)"; then exit 1; fi'
docker cp "$release/container-check.s" "$container:/tmp/container-check.s"
check --mode audit --output /tmp/state-after.json
docker cp "$container:/tmp/state-after.json" "$backup/state-after.json"
cmp "$backup/state-before.json" "$backup/state-after.json"
[[ $(sha256sum "$state/token" | cut -d' ' -f1) == "$token_before" ]]
check --mode gpu --gpus 2
{
  printf '#!/usr/bin/env bash\nset -euo pipefail\nif docker container inspect sputnik-remote-core >/dev/null 2>&1; then\n  exec docker start sputnik-remote-core\nfi\nexec %q' "$release/run-container"
  printf ' %q' "${args[@]}"
  printf '\n'
} > "$root/start-current.sh.new"
chmod 755 "$root/start-current.sh.new"
mv "$root/start-current.sh.new" "$root/start-current.sh"
rollback=false
printf 'PASS 22176: healthy updated core, short torch import, both NVIDIA GPUs, no Python, state/token preserved; image=%s backup=%s previous=%s\n' "$image" "$backup" "$previous"
